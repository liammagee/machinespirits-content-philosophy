#!/usr/bin/env bash
# Validate the deployable content package without publishing it.
#
# This is the source-package contract for the website handoff. The website
# owns Techne rendering and validates generated public routes in its integration
# workflow; this repository validates publication metadata and source outputs.
#
# Usage:
#   ./validate
#   ./validate --strict-metadata   # also fail on thin essay index metadata

set -euo pipefail
cd "$(dirname "$0")"

strict_metadata=0
case "${1:-}" in
  "") ;;
  --strict-metadata) strict_metadata=1 ;;
  --help|-h) sed -n '2,/^$/p' "$0" | sed 's/^# \?//'; exit 0 ;;
  *) echo "validate: unknown argument: $1" >&2; exit 2 ;;
esac

fail() {
  echo "validate: $*" >&2
  exit 1
}

fm_scalar() {
  local file="$1" key="$2"
  awk -v key="$key" '
    NR == 1 { if ($0 != "---") exit; in_fm = 1; next }
    in_fm && $0 == "---" { exit }
    in_fm && index($0, key ":") == 1 {
      value = substr($0, length(key) + 2)
      sub(/^[ \t]*/, "", value)
      sub(/[ \t]*#.*/, "", value)
      gsub(/^["'"'"']|["'"'"']$/, "", value)
      sub(/[ \t]*$/, "", value)
      print value
      exit
    }
  ' "$file"
}

echo "Content package validation"

for script in build publish urls lint validate test-essay-exclusions \
  test-render-exclusions lib/essay-exclusions.sh lib/render-exclusions.sh; do
  bash -n "$script" || fail "$script has invalid shell syntax"
done

./test-essay-exclusions
./test-render-exclusions

# Drift check the render manifest. ./build already refuses to overwrite an
# unlisted hand-authored page, so what remains to catch is a stale entry:
# one naming a file that has gone, or that is now ordinary Pandoc output.
source lib/render-exclusions.sh
load_render_exclusions config/render-exclusions.txt \
  || fail "config/render-exclusions.txt did not load"
render_entries=0
for entry in "${RENDER_EXCLUSION_PATTERNS[@]:-}"; do
  [ -n "$entry" ] || continue
  case "$entry" in *[\*?[]*) continue ;; esac
  render_entries=$((render_entries + 1))
  entry_html="${entry%.md}.html"
  [ -f "$entry" ] \
    || fail "render exclusion names a missing source: $entry"
  [ -s "$entry_html" ] \
    || fail "render exclusion has no sibling page: $entry_html"
  if head -40 "$entry_html" \
    | grep -qE 'name="generator" content="pandoc|xmlns="http://www\.w3\.org/1999/xhtml"'; then
    fail "stale render exclusion — $entry_html is Pandoc output, so $entry should be built: $entry"
  fi
done
echo "render exclusions: OK — $render_entries protected page(s)."

./urls check
./sitemap --check
./artifacts-index --check

public_count=0
while IFS= read -r course_md; do
  [ -n "$course_md" ] || continue
  course_id="$(fm_scalar "$course_md" id)"
  [ -n "$course_id" ] || course_id="$(basename "$(dirname "$course_md")")"
  public_slug="$(fm_scalar "$course_md" public_slug)"
  [ -n "$public_slug" ] || public_slug="$course_id"
  published="$(fm_scalar "$course_md" published)"

  case "$published" in
    true)
      public_count=$((public_count + 1))
      while IFS= read -r material_md; do
        [ -n "$material_md" ] || continue
        test -s "${material_md%.md}.html" \
          || fail "published course material has no rendered HTML: $material_md"
      done < <(find "$(dirname "$course_md")" -maxdepth 1 -name '*.md' -type f ! -name course.md | LC_ALL=C sort)
      ;;
    false) : ;;
    *) fail "$course_md must declare published: true or published: false" ;;
  esac
done < <(find courses -mindepth 2 -maxdepth 2 -name course.md -type f | LC_ALL=C sort)

if [ "$strict_metadata" = 1 ]; then
  ./lint --strict
else
  ./lint
fi

echo "validate: OK — $public_count public courses; source metadata and generated content outputs agree."
